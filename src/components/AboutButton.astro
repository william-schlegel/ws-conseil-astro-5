---
import { Image } from "astro:assets";
import me from "../assets/site/me.jpg";

interface Props {
  active?: boolean;
}

const { active = false } = Astro.props;
---

<a
  href="/about"
  class="about-btn"
  aria-current={active ? "page" : undefined}
  data-magnetic="0.25"
>
  <span class="about-label">About Me</span>
  <Image
    src={me}
    alt=""
    width={72}
    height={72}
    class="about-avatar"
    loading="eager"
  />
</a>

<style>
  .about-btn {
    grid-column: 3;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.3rem 0.3rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(44, 221, 155, 0.5);
    background: rgba(44, 221, 155, 0.1);
    color: var(--mint);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      translate 0.5s var(--ease-out);
  }

  .about-btn:hover,
  .about-btn[aria-current="page"] {
    background: var(--mint);
    color: var(--navy);
  }

  .about-btn :global(.about-avatar) {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    object-fit: cover;
    transition: scale 0.5s var(--ease-spring);
  }

  .about-btn:hover :global(.about-avatar) {
    scale: 1.12;
  }
</style>
