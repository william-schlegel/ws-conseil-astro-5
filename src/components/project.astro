---
import {
  type CollectionEntry,
  getEntries,
  getEntry,
  render,
} from "astro:content";
import {
  projectBriefTransitionName,
  projectImageTransitionName,
  projectTitleTransitionName,
} from "../lib/projectTransitions";
import { displayDate } from "../lib/utils";
import Technos from "./Technos.astro";
import { Image } from "astro:assets";

interface Props {
  project: CollectionEntry<"projetCollection">;
}

const { project } = Astro.props;
const client = project.data.client ? await getEntry(project.data.client) : null;
const technos = project.data.technos
  ? await getEntries(project.data.technos)
  : null;
const categories = project.data.categories
  ? await getEntries(project.data.categories)
  : null;
const links = project.data.links ? await getEntries(project.data.links) : null;
const roles = project.data.roles ? await getEntries(project.data.roles) : null;
const { Content } = await render(project);
const running = !project.data.endDate;
---

<section class="wrap project-head">
  <a href="/projects" class="back mono" data-reveal>
    <span aria-hidden="true">←</span> Tous mes projets
  </a>
  <h1
    class="project-title vt-text"
    transition:name={projectTitleTransitionName(project.data.slug)}
    transition:animate="initial"
  >
    {project.data.name}
  </h1>
  <p
    class="lead project-brief vt-text"
    transition:name={projectBriefTransitionName(project.data.slug)}
    transition:animate="initial"
  >
    {project.data.brief}
  </p>
</section>

<section class="wrap project-main">
  <figure class="project-hero">
    <Image
      src={project.data.heroImage}
      alt={project.data.heroImageAlt || project.data.name}
      class="project-hero-img"
      widths={[640, 960, 1440]}
      sizes="(min-width: 1024px) 58vw, 92vw"
      loading="eager"
      transition:name={projectImageTransitionName(project.data.slug)}
      transition:animate="initial"
    />
  </figure>

  <aside class="fiche" data-stagger="90" aria-label="Fiche du projet">
    {
      client ? (
        <div class="fiche-row" data-reveal>
          <p class="mono">Client</p>
          <div class="fiche-client">
            <span class="disc">
              <Image src={client.data.image} alt="" width={160} />
            </span>
            <p>{client.data.name}</p>
          </div>
        </div>
      ) : null
    }
    <div class="fiche-row" data-reveal>
      <p class="mono">Période</p>
      <p class="fiche-date">
        {running && <span class="beacon" />}
        {displayDate(project.data.startDate, project.data.endDate)}
      </p>
    </div>
    {
      categories ? (
        <div class="fiche-row" data-reveal>
          <p class="mono">Catégories</p>
          <ul class="fiche-chips">
            {categories.map((cat) => (
              <li class="chip chip--mint">{cat.data.title}</li>
            ))}
          </ul>
        </div>
      ) : null
    }
    {
      roles ? (
        <div class="fiche-row" data-reveal>
          <p class="mono">Rôles</p>
          <ul class="fiche-roles">
            {roles.map((role) => (
              <li>
                <span class="disc">
                  <Image
                    src={role.data.image}
                    alt=""
                    height={64}
                    width={64}
                  />
                </span>
                <span>{role.data.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ) : null
    }
    {
      technos ? (
        <div class="fiche-row" data-reveal>
          <Technos
            technos={technos}
            variant="chips"
            title="Technos utilisées sur ce projet"
          />
        </div>
      ) : null
    }
  </aside>
</section>

<section class="wrap-narrow project-body">
  <div class="prose-chart" data-reveal-children>
    <Content />
  </div>
  {
    links ? (
      <ul class="project-links" data-reveal>
        {links.map((link) => (
          <li>
            <a
              href={link.data.url}
              target="_blank"
              rel="noreferrer"
              class="btn"
              data-magnetic="0.25"
            >
              {link.data.title}
              <span class="arrow" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : null
  }
</section>

<style>
  .project-head {
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .back {
    display: inline-flex;
    gap: 0.6rem;
    padding: 0.5rem 0;
    color: var(--mint);
    transition: gap 0.4s var(--ease-out);
  }

  .back:hover {
    gap: 1.1rem;
  }

  .project-title {
    margin-top: 1.25rem;
    font-size: clamp(2.6rem, 5.6vw + 0.7rem, 6.5rem);
    color: var(--foam);
    width: fit-content;
    max-width: 100%;
  }

  .project-brief {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    max-width: 46rem;
    width: fit-content;
  }

  .project-main {
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }

  @media (min-width: 64rem) {
    .project-main {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    }
  }

  .project-hero {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--navy);
    box-shadow: 0 50px 90px -50px rgba(0, 0, 0, 0.95);
  }

  .project-hero :global(.project-hero-img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    view-transition-class: vt-image;
  }

  /* --- fiche --- */
  .fiche {
    display: grid;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(
      180deg,
      rgba(7, 32, 52, 0.84),
      rgba(3, 15, 27, 0.9)
    );
  }

  .fiche-row {
    display: grid;
    gap: 0.7rem;
    padding: 1.15rem clamp(1.1rem, 2vw, 1.6rem);
  }

  .fiche-row + .fiche-row {
    border-top: 1px solid var(--line);
  }

  .fiche-client {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .fiche-client .disc {
    width: 4.25rem;
    padding: 0.5rem;
  }

  .fiche-client :global(img),
  .fiche-roles :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fiche-date {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--cyan);
  }

  .fiche-chips,
  .fiche-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .fiche-roles li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.2rem 0.95rem 0.2rem 0.2rem;
    border-radius: 999px;
    background: var(--mint);
    color: var(--navy);
    font-weight: 600;
    font-size: 0.9rem;
    line-height: 1;
  }

  .fiche-roles .disc {
    width: 2.1rem;
    box-shadow: none;
  }

  /* --- contenu --- */
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
</style>
