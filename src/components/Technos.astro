---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  technos: Array<CollectionEntry<"technoCollection">>;
  /** "icons" : pastilles seules — "chips" : pastille + nom */
  variant?: "icons" | "chips";
  title?: string;
  class?: string;
}

const { technos, variant = "icons", title, class: className } = Astro.props;
---

{
  Array.isArray(technos) && technos.length > 0 ? (
    <div class:list={["technos", `technos--${variant}`, className]}>
      {title && <p class="mono technos-title">{title}</p>}
      <ul>
        {technos.map((tech) => (
          <li title={tech.data.name}>
            <span class="disc">
              <Image
                src={tech.data.image}
                width={56}
                height={56}
                alt={variant === "icons" ? tech.data.name : ""}
              />
            </span>
            {variant === "chips" && <span>{tech.data.name}</span>}
          </li>
        ))}
      </ul>
    </div>
  ) : null
}

<style>
  .technos-title {
    margin-bottom: 0.75rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .disc {
    width: 1.9rem;
    padding: 0.28rem;
  }

  .disc :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .technos--chips ul {
    gap: 0.5rem;
  }

  .technos--chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.2rem 0.9rem 0.2rem 0.2rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(2, 14, 26, 0.55);
    font-size: 0.9rem;
    line-height: 1;
    transition:
      border-color 0.3s ease,
      translate 0.4s var(--ease-spring);
  }

  .technos--chips li:hover {
    border-color: var(--mint);
    translate: 0 -2px;
  }
</style>
