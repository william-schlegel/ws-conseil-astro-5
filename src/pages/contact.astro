---
import Layout from "../layouts/Layout.astro";

const code = Astro.url.searchParams.get("erreur");
const erreurs: Record<string, string> = {
  req: "Requête invalide. Réessayez depuis le formulaire.",
  champs: "Tous les champs obligatoires doivent être renseignés.",
  longueur: "Un ou plusieurs champs sont trop longs.",
  email: "Adresse e-mail invalide.",
  config: "Le service est momentanément indisponible.",
  envoi: "L’envoi du message a échoué. Réessayez plus tard.",
};
const erreurMessage = code ? (erreurs[code] ?? "Une erreur est survenue.") : null;
---

<Layout
  title="Contact — WS Conseil"
  description="Envoyer un message à WS Conseil."
>
  <main>
    <section class="wrap contact">
      <div class="contact-copy">
        <h1 data-split style="--d: 0.1s">Contact</h1>
        <p class="lead" data-reveal style="--d: 0.45s">
          Écrivez-moi via ce formulaire. Je vous répondrai dès que possible.
        </p>
        <!-- Ancre de la formation de particules : anneaux sonar -->
        <div class="sonar" data-formation="sonar" aria-hidden="true">
          <span class="sonar-dot"></span>
        </div>
      </div>

      <div class="contact-panel" data-reveal style="--d: 0.3s">
        <!--
          Le message d'erreur est rendu côté serveur quand le paramètre est
          connu, sinon complété côté client (page pré-rendue) : voir
          scripts/pages.ts.
        -->
        <p
          role="alert"
          class="contact-error"
          data-contact-error
          data-messages={JSON.stringify(erreurs)}
          hidden={!erreurMessage}
        >
          {erreurMessage}
        </p>
        <form
          method="POST"
          action="/api/contact"
          class="contact-form"
          accept-charset="UTF-8"
          enctype="application/x-www-form-urlencoded"
          data-astro-reload
          data-contact-form
        >
          <div class="field">
            <input
              id="contact-name"
              name="name"
              type="text"
              required
              maxlength="200"
              autocomplete="name"
              placeholder=" "
            />
            <label for="contact-name">Nom</label>
            <span class="field-line" aria-hidden="true"></span>
          </div>
          <div class="field">
            <input
              id="contact-email"
              name="email"
              type="email"
              required
              maxlength="254"
              autocomplete="email"
              placeholder=" "
            />
            <label for="contact-email">E-mail</label>
            <span class="field-line" aria-hidden="true"></span>
          </div>
          <div class="field field--area">
            <textarea
              id="contact-message"
              name="message"
              required
              maxlength="10000"
              rows="7"
              placeholder=" "></textarea>
            <label for="contact-message">Message</label>
            <span class="field-line" aria-hidden="true"></span>
          </div>
          <div class="sr-only" aria-hidden="true">
            <label for="contact-company">Ne pas remplir ce champ</label>
            <input
              id="contact-company"
              name="company"
              type="text"
              tabindex="-1"
              autocomplete="off"
              value=""
            />
          </div>
          <button type="submit" class="btn btn--primary contact-submit">
            <span data-label>Envoyer</span>
            <span class="arrow" aria-hidden="true">→</span>
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    }
  }

  .contact h1 {
    margin-top: 1.25rem;
    font-size: clamp(4rem, 11vw, 11rem);
    letter-spacing: -0.05em;
  }

  .contact .lead {
    margin-top: clamp(1.25rem, 2.5vw, 2rem);
    max-width: 28rem;
  }

  .sonar {
    position: relative;
    width: min(92%, 27rem);
    aspect-ratio: 1;
    margin-top: clamp(0rem, 1vw, 1rem);
    margin-left: -2rem;
    display: grid;
    place-items: center;
  }

  .sonar-dot {
    width: 0.7rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 24px 4px rgba(44, 221, 155, 0.7);
  }

  @media (max-width: 59.99rem) {
    .sonar {
      position: absolute;
      right: calc(var(--gutter) * -1);
      top: -2rem;
      width: 13rem;
      margin: 0;
      opacity: 0.8;
    }

    .contact-copy {
      position: relative;
    }
  }

  /* ----------------------------------------------------------- formulaire */
  .contact-panel {
    position: relative;
    padding: clamp(1.25rem, 3.5vw, 2.75rem);
    border-radius: calc(var(--radius) * 1.3);
    border: 1px solid var(--line);
    background: linear-gradient(
      180deg,
      rgba(7, 32, 52, 0.86),
      rgba(3, 15, 27, 0.93)
    );
    box-shadow: 0 50px 100px -60px rgba(0, 0, 0, 0.95);
  }

  .contact-error {
    margin-bottom: 1.5rem;
    padding: 0.85rem 1.1rem;
    border-radius: 0.8rem;
    border: 1px solid color-mix(in srgb, var(--buoy) 60%, transparent);
    background: color-mix(in srgb, var(--buoy) 14%, transparent);
    color: #ffd9c4;
    font-size: 0.95rem;
  }

  .contact-error[hidden] {
    display: none;
  }

  .contact-form {
    display: grid;
    gap: clamp(1.4rem, 3vw, 2rem);
  }

  .field {
    position: relative;
  }

  .field input,
  .field textarea {
    display: block;
    width: 100%;
    padding: 1.7rem 0 0.7rem;
    border: 0;
    border-bottom: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    color: var(--foam);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.8vw + 1rem, 1.6rem);
    line-height: 1.3;
    caret-color: var(--mint);
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .field input:focus,
  .field textarea:focus {
    outline: none;
    box-shadow: none;
  }

  .field input:-webkit-autofill {
    -webkit-text-fill-color: var(--foam);
    box-shadow: 0 0 0 100px #061c2f inset;
  }

  .field label {
    position: absolute;
    left: 0;
    top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.8vw + 1rem, 1.6rem);
    line-height: 1.3;
    color: var(--mist);
    pointer-events: none;
    transform-origin: 0 0;
    transition:
      translate 0.45s var(--ease-out),
      scale 0.45s var(--ease-out),
      color 0.3s ease;
  }

  .field input:focus + label,
  .field textarea:focus + label,
  .field input:not(:placeholder-shown) + label,
  .field textarea:not(:placeholder-shown) + label {
    translate: 0 -1.7rem;
    scale: 0.52;
    color: var(--mint);
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .field-line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--mint);
    box-shadow: 0 0 16px rgba(44, 221, 155, 0.8);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.7s var(--ease-out);
  }

  .field--area .field-line {
    bottom: 0;
  }

  .field:focus-within .field-line {
    scale: 1 1;
  }

  .contact-submit {
    justify-self: start;
    margin-top: 0.5rem;
    padding: 1.15rem 2.1rem;
    font-size: 1.1rem;
  }

  .contact-submit[data-sending] {
    pointer-events: none;
    opacity: 0.75;
  }

  .contact-submit[data-sending] .arrow {
    animation: sending 0.9s var(--ease-inout) infinite;
  }

  @keyframes sending {
    0% {
      translate: -0.6rem 0;
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      translate: 0.8rem 0;
      opacity: 0;
    }
  }
</style>
