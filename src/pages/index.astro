---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projetsCol = await getCollection("projetCollection");
const projets = projetsCol
  .sort((p1, p2) =>
    new Date(p1.data.startDate) < new Date(p2.data.startDate) ? 1 : -1,
  )
  .slice(0, 4);

const roles = await getCollection("roleCollection");
const categories = await getCollection("categoryCollection");
const clients = await getCollection("clientCollection");
const technos = await getCollection("technoCollection");
const experiences = await getCollection("experienceCollection");

const firstYear = Math.min(
  ...experiences.map((exp) => new Date(exp.data.startDate).getFullYear()),
);
const stats = [
  { value: new Date().getFullYear() - firstYear, label: "ans de parcours" },
  { value: projetsCol.length, label: "projets" },
  { value: clients.length, label: "clients" },
  { value: technos.length, label: "technos" },
];
---

<Layout title="Home" description="WS Conseil CTO as a Service">
  <main class="home">
    <section class="hero wrap">
      <div class="hero-copy">
        <p class="mono eyebrow" data-reveal>WS Conseil · CTO as a Service</p>
        <h1 data-split style="--d: 0.15s">
          Passez à la <em>vitesse supérieure</em> avec un CTO/Lead dev expérimenté
          <em>à la demande</em>
        </h1>
        <div class="hero-actions" data-reveal style="--d: 0.85s">
          <a href="/contact" class="btn btn--primary" data-magnetic="0.3">
            Contactez-moi <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a href="/projects" class="btn" data-magnetic="0.3">
            Tous mes projets
          </a>
        </div>
      </div>

      <!-- Ancre de la formation de particules : la spirale du logo -->
      <div class="hero-spiral" data-formation="spiral" aria-hidden="true"></div>

      <dl class="stats">
        {
          stats.map((stat, i) => (
            <div class="stat" data-reveal style={`--d: ${1000 + i * 110}ms`}>
              <dd data-count={stat.value}>{stat.value}</dd>
              <dt class="mono">{stat.label}</dt>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="bands" aria-label="Rôles et domaines">
      <div class="band band--roles" data-marquee="46">
        <ul data-marquee-track>
          {
            roles.map((role) => (
              <li>
                <span>{role.data.name}</span>
                <i aria-hidden="true" />
              </li>
            ))
          }
        </ul>
      </div>
      <div class="band band--cats" data-marquee="60" data-marquee-dir="-1">
        <ul data-marquee-track>
          {
            categories.map((cat) => (
              <li>
                <span class="chip">{cat.data.title}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="latest wrap">
      <header class="section-head">
        <h2 data-split>Mes derniers projets</h2>
        <span class="rule" data-reveal="rule"></span>
      </header>
      <div class="latest-grid">
        {
          projets.map((projet, index) => (
            <ProjectCard
              project={projet.data}
              delay={(index % 2) * 140}
            />
          ))
        }
      </div>
      <p class="latest-more" data-reveal>
        <a href="/projects" class="link-arrow">
          Tous mes projets <span class="arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </section>

    <section class="cta wrap">
      <a href="/contact" class="cta-link" data-cursor="Écrire">
        <span data-split>Contactez-moi</span>
        <span class="cta-arrow" aria-hidden="true" data-reveal="scale">→</span>
      </a>
    </section>
  </main>
</Layout>

<style>
  .home {
    padding-top: 0;
  }

  /* ---------------------------------------------------------------- hero */
  .hero {
    position: relative;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 6vh, 4.5rem));
    padding-bottom: clamp(1.5rem, 4vh, 3rem);
    display: grid;
    grid-template-rows: 1fr auto;
    gap: clamp(1.5rem, 4vh, 3rem);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    align-self: center;
    max-width: 62rem;
  }

  .hero h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.55rem, 5.5vw + 0.6rem, 6.4rem);
    max-width: 15.5em;
    text-shadow: 0 2px 40px rgba(2, 10, 19, 0.75);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 4vh, 3rem);
  }

  .hero-spiral {
    position: absolute;
    right: calc(var(--gutter) * -0.6);
    top: 48%;
    translate: 0 -50%;
    width: min(50vw, 46rem, 82svh);
    aspect-ratio: 1;
    pointer-events: none;
  }

  .stats {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem clamp(1rem, 4vw, 4rem);
    max-width: 52rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .stat dd {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 3.2vw + 0.6rem, 3.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--mint);
  }

  .stat dt {
    margin-top: 0.5rem;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-rows: auto auto auto;
      min-height: 0;
    }

    .hero-spiral {
      position: relative;
      right: auto;
      top: auto;
      translate: none;
      width: min(86vw, 26rem);
      margin: -0.5rem auto;
    }

    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* --------------------------------------------------------- défilants */
  .bands {
    margin-block: clamp(3rem, 8vw, 7rem);
    display: grid;
    gap: 1.5rem;
    overflow: clip;
    rotate: -2deg;
    scale: 1.04;
  }

  .band {
    overflow: hidden;
    white-space: nowrap;
  }

  .band ul {
    display: inline-flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  .band li {
    display: inline-flex;
    align-items: center;
  }

  .band--roles {
    padding-block: 0.6rem;
    border-block: 1px solid var(--line);
    background: rgba(2, 10, 19, 0.45);
  }

  .band--roles span {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(2.5rem, 7vw, 6.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    padding-inline: clamp(1rem, 2.5vw, 2.5rem);
  }

  .band--roles li:nth-child(even) span {
    color: transparent;
    -webkit-text-stroke: 1px var(--mint);
  }

  .band--roles i {
    width: clamp(0.6rem, 1.2vw, 1rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 18px rgba(44, 221, 155, 0.8);
  }

  .band--cats li {
    padding-inline: 0.4rem;
  }

  .band--cats .chip {
    font-size: 0.72rem;
    padding: 0.55rem 1.1rem;
  }

  /* ----------------------------------------------------- derniers projets */
  .latest-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
    gap: clamp(1.25rem, 3vw, 2.75rem);
  }

  @media (min-width: 60rem) {
    .latest-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .latest-grid > :global(:nth-child(even)) {
      margin-top: 6rem;
      margin-bottom: -6rem;
    }

    .latest-more {
      padding-top: 6rem;
    }
  }

  .latest-more {
    margin-top: clamp(2rem, 4vw, 3.5rem);
    font-size: 1.15rem;
  }

  /* ------------------------------------------------------------------ cta */
  .cta {
    margin-top: clamp(5rem, 12vw, 10rem);
  }

  .cta-link {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 clamp(1rem, 3vw, 3rem);
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(3rem, 12.5vw, 13rem);
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--foam);
    transition:
      color 0.5s var(--ease-out),
      letter-spacing 0.9s var(--ease-out);
  }

  .cta-link:hover {
    color: var(--mint);
    font-style: italic;
    letter-spacing: -0.035em;
  }

  .cta-arrow {
    display: grid;
    place-items: center;
    width: 1.15em;
    height: 1.15em;
    font-size: 0.42em;
    font-style: normal;
    border-radius: 50%;
    border: 1px solid var(--mint);
    color: var(--mint);
    transition:
      background-color 0.45s var(--ease-out),
      color 0.45s var(--ease-out),
      rotate 0.7s var(--ease-out),
      scale 1.1s var(--ease-out),
      opacity 0.9s var(--ease-out);
  }

  .cta-link:hover .cta-arrow {
    background: var(--mint);
    color: var(--navy);
    rotate: -45deg;
  }
</style>
