---
import { getCollection, getEntries } from "astro:content";
import Layout from "../layouts/Layout.astro";
import ExpByCat from "../components/ExpByCat.astro";
import { Image } from "astro:assets";
import me from "../assets/site/me.jpg";
import trail from "../assets/site/trail-bretagne-1024.webp";

const experiences = (await getCollection("experienceCollection")).sort(
  (e1, e2) => (new Date(e1.data.startDate) < new Date(e2.data.startDate) ? 1 : -1),
);

// Catégories dans l'ordre éditorial (champ `order`).
const categories = (
  await getEntries(
    Array.from(new Set(experiences.map((exp) => exp.data.category.id))).map(
      (id) => ({ collection: "categoryCollection" as const, id }),
    ),
  )
).sort((c1, c2) => c1.data.order - c2.data.order);

// Frise du parcours : une ligne par expérience, de la première à aujourd'hui.
const now = new Date();
const firstYear = Math.min(
  ...experiences.map((exp) => new Date(exp.data.startDate).getFullYear()),
);
const axisStart = new Date(firstYear, 0, 1).getTime();
const axisEnd = new Date(now.getFullYear() + 1, 0, 1).getTime();
const pct = (time: number) =>
  ((Math.min(time, now.getTime()) - axisStart) / (axisEnd - axisStart)) * 100;

const rows = [...experiences].reverse().map((exp) => {
  const start = new Date(exp.data.startDate);
  const end = exp.data.endDate ? new Date(exp.data.endDate) : null;
  const left = pct(start.getTime());
  const right = pct(end ? end.getTime() : now.getTime());
  return {
    exp,
    left,
    width: Math.max(1.2, right - left),
    running: !end,
    alignEnd: left > 38,
    years: `${start.getFullYear()} → ${end ? end.getFullYear() : "…"}`,
  };
});

const ticks: Array<{ year: number; left: number }> = [];
for (let year = firstYear; year <= now.getFullYear(); year += 4) {
  ticks.push({ year, left: pct(new Date(year, 0, 1).getTime()) });
}

const socials = [
  {
    href: "https://ironeec.com",
    title: "Mon blog personnel",
    label: "Blog",
    viewBox: "0 0 57.1 57.1",
    filled: true,
    strokeWidth: 2,
    d: "M53.7 41.5A28.4 28.4 0 1 0 41 54l2.7 2.7a2 2 0 0 0 2.8 0l9.7-9.8a2 2 0 0 0 0-2.8l-2.5-2.5zM49.1 37c1.6-.5 3.3-1 5-1.7-.5 1.6-1.1 3.3-1.9 4.8l-3.1-3zm-1-10.6c-.2-.5-.8-.8-1.4-.8H40a70 70 0 0 0-.5-5.5c5 .8 10 2.2 15 4.2h.1a26.4 26.4 0 0 1 0 8.6h-.2a68 68 0 0 1-7 2.5l-3.6-3.6 3.9-3.9c.4-.4.6-1 .4-1.5zm-23 1.1V38c-1.8 0-3.6-.2-5.4-.5-.8-5.9-.8-11.8 0-17.8 5.9-.7 11.8-.7 17.7 0l.6 5.9H27c-1 0-1.8.8-1.8 2zM2.7 32.8a26.4 26.4 0 0 1 0-8.5s0 0 0 0c5-2 10-3.5 15-4.3-.7 5.7-.7 11.4 0 17.1a67.4 67.4 0 0 1-15-4.2s0 0 0 0zM54 22a70 70 0 0 0-14.9-4.1 69.3 69.3 0 0 0-4.1-15 26.5 26.5 0 0 1 19 19zM32.8 2.4v.3c2 4.8 3.5 9.8 4.3 14.9-5.7-.7-11.4-.7-17.1 0a68.1 68.1 0 0 1 4.3-15.2 26.3 26.3 0 0 1 8.5 0zM22 2.8c-2 5-3.3 10-4.1 15a70 70 0 0 0-15 4.2A26.5 26.5 0 0 1 22 2.8zM3 35.2c4.9 1.9 9.8 3.2 14.9 4 .8 5 2.1 9.9 4 14.7A26.5 26.5 0 0 1 3 35.2zm21.2 19.2a68 68 0 0 1-4.2-15c1.7.3 3.4.4 5.2.5V47c0 1 .6 1.5 1.2 1.5.3 0 .7-.1 1.1-.5l3.8-3.9 3.9 4c-.7 2-1.4 4.2-2.3 6.3a26.6 26.6 0 0 1-8.7 0zm11-.5a70 70 0 0 0 1.6-4.3l2.7 2.8a26 26 0 0 1-4.3 1.5zm9.900 1.2L32.7 42.700c-.4-.4-.9-.6-1.4-.6s-1 .2-1.3.6L27 45.500v-18h18l-2.7 2.800a2 2 0 0 0 0 2.700l12.400 12.400-9.700 9.700z",
  },
  {
    href: "https://www.linkedin.com/in/williamschlegel",
    title: "Mon profile sur LinkedIn",
    label: "LinkedIn",
    viewBox: "0 0 24 24",
    filled: false,
    strokeWidth: 2,
    d: "M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z",
    circle: { cx: 4, cy: 4, r: 2 },
  },
  {
    href: "https://www.malt.fr/profile/williamschlegel",
    title: "Mon profile sur Malt",
    label: "Malt",
    viewBox: "0 0 277 277",
    filled: false,
    strokeWidth: 20,
    d: "M187.5 84.7c-14-14-29.1-5-38.6 4.5l-44.5 44.5L60 178.2c-9.4 9.5-19.3 23.8-4.5 38.6 14.9 14.9 29.2 5 38.6-4.4l44.5-44.6 44.6-44.5c9.4-9.4 18.5-24.5 4.4-38.6M102.4 81l18.9 19 19.2-19.3c1.3-1.3 2.6-2.5 4-3.600-2-10.200-7.800-19.300-23.200-19.300C105.900 57.800 100 67 98 77a79 79 0 0 1 4.300 4M140.500 221.100 121.300 202l-18.800 18.800a81 81 0 0 1-4.300 4c2.100 10.300 8.300 19.800 23 19.800 15 0 21-9.500 23.200-20-1.300-1-2.600-2.200-4-3.500M94.400 126.800H58.100c-13.300 0-30.400 4.200-30.400 24.100 0 14.900 9.500 21 19.900 23.200 1.200-1.500 46.800-47.300 46.800-47.300M195.100 127.800c-1.100 1.300-47 47.300-47 47.300h36c13.300 0 30.400-3.200 30.400-24.200 0-15.400-9.200-21.100-19.400-23.100M106.400 114.900l6.500-6.500L94 89.500c-9.400-9.400-23.700-19.300-38.600-4.400-10.900 10.900-8.400 21.400-2.700 30l53.700-.2M136.200 187l-6.500 6.500 19.200 19.200c9.400 9.400 24.500 18.600 38.600 4.500 10.500-10.600 8.100-21.600 2.300-30.500-1.900.2-53.600.3-53.600.3",
  },
  {
    href: "https://twitter.com/wsc_ironeec",
    title: "Mon compte Twitter",
    label: "X / Twitter",
    viewBox: "0 0 24 24",
    filled: true,
    strokeWidth: 0,
    d: "M18.2 2.3h3.4l-7.3 8.2 8.5 11.3h-6.6L11 14.8l-6 6.800H1.700L9.400 13 1.300 2.200H8l4.700 6.300zm-1.100 17.500h1.800L7.100 4H5z",
  },
];
---

<Layout title="À propos" description="William Schlegel, CEO, CTOaaS & Lead dev">
  <main>
    <section class="wrap intro">
      <div class="intro-copy">
        <p class="mono eyebrow" data-reveal>À propos</p>
        <h1 data-split style="--d: 0.1s">
          Mon nom est <em>William Schlegel,</em> CEO, CTOaaS* & Lead dev
        </h1>
        <p class="lead intro-sub" data-reveal style="--d: 0.55s">
          CTO de transition, Lead developer
        </p>
        <p class="mono" data-reveal style="--d: 0.62s">(*CTO as a Service)</p>
        <p class="intro-bio" data-reveal style="--d: 0.75s">
          Passionné par le développement informatique et la gestion de projets
          numériques, j’ai construit mon parcours autour de la conception de
          solutions innovantes et de la coordination d’équipes techniques. Fort
          d’une solide expérience dans divers secteurs, je sais allier rigueur,
          créativité et sens de l’organisation pour mener à bien des initiatives
          complexes. Mon approche repose sur une communication efficace,
          l’amélioration continue et la recherche d’outils pertinents pour
          optimiser la performance. Curieux de nature, j’apprécie
          particulièrement d’évoluer au sein d’environnements collaboratifs où
          l’échange d’idées et le dépassement de soi contribuent à la réussite
          des objectifs.
        </p>
        <ul class="socials">
          {
            socials.map((social, i) => (
              <li data-reveal style={`--d: ${900 + i * 80}ms`}>
                <a
                  href={social.href}
                  title={social.title}
                  target="_blank"
                  rel="noreferrer"
                  class="social"
                  data-magnetic="0.3"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox={social.viewBox}
                    fill={social.filled ? "currentColor" : "none"}
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width={social.strokeWidth}
                    aria-hidden="true"
                  >
                    <path d={social.d} />
                    {social.circle && <circle {...social.circle} />}
                  </svg>
                  <span>{social.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <figure class="portrait" data-reveal="scale" style="--d: 0.3s">
        <div class="portrait-disc" data-formation="ring">
          <Image
            src={me}
            alt="William Schlegel"
            width={640}
            height={640}
            loading="eager"
          />
        </div>
        <svg class="portrait-ring" viewBox="0 0 200 200" aria-hidden="true">
          <circle cx="100" cy="100" r="98"></circle>
          <path id="portrait-arc" d="M100 100m-91 0a91 91 0 1 1 182 0a91 91 0 1 1-182 0" fill="none"></path>
          <text>
            <textPath href="#portrait-arc">
              William Schlegel · CEO · CTOaaS · Lead dev · Valmondois (95) ·
            </textPath>
          </text>
        </svg>
      </figure>
    </section>

    <section class="wrap parcours">
      <header class="section-head">
        <p class="mono eyebrow" data-reveal>Parcours</p>
        <h2 data-split>Voici quelques expériences passées significatives</h2>
        <span class="rule" data-reveal="rule"></span>
      </header>

      <div class="parcours-top">
        <div class="frise" data-reveal="fade">
          <div class="frise-plot">
            <div class="frise-ticks" aria-hidden="true">
              {
                ticks.map((tick) => (
                  <span
                    class:list={{ "is-end": tick.left > 88 }}
                    style={`left: ${tick.left.toFixed(2)}%`}
                  >
                    <b class="mono">{tick.year}</b>
                  </span>
                ))
              }
            </div>
            <ol class="frise-rows">
              {
                rows.map((row, i) => (
                  <li
                    data-cat={row.exp.data.category.id}
                    data-reveal="fade"
                    style={`--l: ${row.left.toFixed(2)}%; --w: ${row.width.toFixed(2)}%; --d: ${250 + i * 130}ms`}
                  >
                    <a href={`#exp-${row.exp.id}`}>
                      <span
                        class:list={[
                          "frise-label",
                          row.alignEnd && "frise-label--end",
                        ]}
                      >
                        <strong>{row.exp.data.name}</strong>
                        <span class="mono">{row.years}</span>
                      </span>
                      <span class="frise-track">
                        <span class="frise-bar">
                          {row.running && <i class="beacon" />}
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ol>
          </div>
          <ul class="frise-legend">
            {
              categories.map((cat) => (
                <li class="mono" data-cat={cat.id}>
                  <i aria-hidden="true" />
                  {cat.data.title}
                </li>
              ))
            }
          </ul>
        </div>

        <figure class="trail" data-reveal="clip">
          <Image
            src={trail}
            alt="William Schlegel en trail sur un sentier côtier en Bretagne"
            widths={[400, 800, 1024]}
            sizes="(min-width: 64rem) 24rem, 92vw"
            data-parallax="0.1"
          />
        </figure>
      </div>

      {
        categories.map((cat, index) => (
          <ExpByCat
            catId={cat.id}
            index={index}
            experiences={experiences.filter(
              (exp) => exp.data.category.id === cat.id,
            )}
          />
        ))
      }
    </section>
  </main>
</Layout>

<style>
  /* ---------------------------------------------------------------- intro */
  .intro {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    margin-bottom: clamp(4.5rem, 10vw, 9rem);
  }

  @media (min-width: 62rem) {
    .intro {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }

  .intro h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.5rem, 4.6vw + 0.7rem, 5.6rem);
  }

  .intro-sub {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--mint);
  }

  .intro-bio {
    margin-top: 1.5rem;
    max-width: 44rem;
    color: color-mix(in srgb, var(--foam) 86%, var(--mist));
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .social {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.6rem 1.1rem 0.6rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgba(2, 14, 26, 0.55);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1;
    transition:
      color 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .social svg {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--mint);
    transition: color 0.3s ease;
  }

  .social:hover,
  .social:focus-visible {
    background: var(--mint);
    border-color: var(--mint);
    color: var(--navy);
  }

  .social:hover svg,
  .social:focus-visible svg {
    color: var(--navy);
  }

  /* -------------------------------------------------------------- portrait */
  .portrait {
    position: relative;
    justify-self: center;
    width: min(74vw, 26rem);
    aspect-ratio: 1;
  }

  .portrait-disc {
    position: absolute;
    inset: 11%;
    border-radius: 50%;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.35),
      0 0 90px -10px rgba(29, 200, 205, 0.55);
  }

  .portrait-disc :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    animation: portrait-spin 60s linear infinite;
  }

  .portrait-ring circle {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 0.4;
    stroke-dasharray: 1 3;
  }

  .portrait-ring text {
    font-family: var(--font-mono);
    font-size: 6.1px;
    letter-spacing: 0.21em;
    text-transform: uppercase;
    fill: var(--mist);
  }

  @keyframes portrait-spin {
    to {
      rotate: 1turn;
    }
  }

  /* ----------------------------------------------------------------- frise */
  .parcours-top {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: stretch;
  }

  @media (min-width: 64rem) {
    .parcours-top {
      grid-template-columns: minmax(0, 1fr) clamp(16rem, 24vw, 22rem);
    }
  }

  .frise {
    display: grid;
    align-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.1rem, 2.5vw, 2rem);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: linear-gradient(
      180deg,
      rgba(7, 32, 52, 0.8),
      rgba(3, 15, 27, 0.88)
    );
  }

  .frise-plot {
    position: relative;
    padding-top: 2rem;
  }

  .frise-ticks {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .frise-ticks span {
    position: absolute;
    top: 0;
    bottom: 0;
    border-left: 1px dashed var(--line);
  }

  .frise-ticks b {
    position: absolute;
    left: 0.35rem;
    top: 0;
    font-weight: 400;
  }

  .frise-ticks .is-end b {
    left: auto;
    right: 0.35rem;
  }

  @media (max-width: 40rem) {
    .frise-ticks span:nth-child(even):not(.is-end) b,
    .frise-ticks span:nth-last-child(2):has(+ .is-end) b {
      display: none;
    }
  }

  .frise-rows {
    position: relative;
    display: grid;
    gap: clamp(0.55rem, 1.2vw, 0.9rem);
  }

  .frise-rows li {
    --cat: var(--mint);
  }

  .frise [data-cat="cat-citizen"] {
    --cat: var(--cyan);
  }

  .frise [data-cat="cat-lecture"] {
    --cat: var(--buoy);
  }

  .frise-rows a {
    display: grid;
    gap: 0.3rem;
    padding-block: 0.15rem;
  }

  .frise-label {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.7rem;
    padding-left: var(--l);
    line-height: 1.2;
  }

  .frise-label--end {
    justify-content: flex-end;
    padding-left: 0;
    padding-right: calc(100% - var(--l) - var(--w));
  }

  .frise-label strong {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1rem, 0.6vw + 0.9rem, 1.3rem);
    transition: color 0.3s ease;
  }

  .frise-rows a:hover strong,
  .frise-rows a:focus-visible strong {
    color: var(--cat);
  }

  .frise-track {
    position: relative;
    display: block;
    height: 0.5rem;
  }

  .frise-bar {
    position: absolute;
    left: var(--l);
    width: var(--w);
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--cat) 35%, transparent),
      var(--cat)
    );
    box-shadow: 0 0 16px -2px var(--cat);
    transform-origin: left;
    transition:
      scale 1.5s var(--ease-inout) var(--d, 0s),
      filter 0.3s ease;
  }

  :global(html.js) .frise-rows li .frise-bar {
    scale: 0 1;
  }

  :global(html.js) .frise-rows li.is-in .frise-bar {
    scale: 1 1;
  }

  .frise-rows a:hover .frise-bar {
    filter: brightness(1.35);
  }

  .frise-bar .beacon {
    position: absolute;
    right: -0.15rem;
    top: 50%;
    translate: 0 -50%;
    width: 0.8rem;
    height: 0.8rem;
    background: var(--cat);
  }

  .frise-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .frise-legend li {
    --cat: var(--mint);
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .frise-legend i {
    width: 1.4rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--cat);
  }

  /* ----------------------------------------------------------------- trail */
  .trail {
    position: relative;
    min-height: 22rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--navy);
  }

  .trail :global(img) {
    position: absolute;
    inset: -12% 0;
    width: 100%;
    height: 124%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .trail::after {
    content: "";
    position: absolute;
    inset: 55% 0 0;
    background: linear-gradient(transparent, rgba(2, 10, 19, 0.85));
  }

  .trail figcaption {
    position: absolute;
    left: 1.1rem;
    bottom: 1rem;
    z-index: 1;
    color: var(--foam);
  }

  @media (max-width: 63.99rem) {
    .trail {
      aspect-ratio: 4 / 3;
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait-ring {
      animation: none;
    }

    :global(html.js) .frise-rows li .frise-bar {
      scale: 1 1;
    }
  }
</style>
